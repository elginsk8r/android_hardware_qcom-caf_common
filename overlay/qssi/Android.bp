soong_namespace {
}

phony {
    name: "QssiCommonOverlay",
    required: [
        "QssiFrameworksOverlay",
        "QssiWifiOverlay",
    ] + select(soong_config_variable("qssi", "atv_or_car"), {
        true: [],
        default: ["QssiFrameworksNoCarAtvOverlay"],
    }) + select(soong_config_variable("qssi", "supports_telephony"), {
        false: [],
        default: ["QssiTelephonyCommonOverlay"],
    }) + select(soong_config_variable("qssi", "supports_wifi6"), {
        true: ["QssiWifi6gOverlay"],
        default: [],
    }),
}

phony {
    name: "QssiTelephonyCommonOverlay",
    required: [
        "QssiFrameworksTelephonyOverlay",
        "QssiTelephonyOverlay",
    ] + select(soong_config_variable("qssi", "supports_ims"), {
        false: [],
        default: [
            "QssiFrameworksTelephonyImsOverlay",
            "QssiTelephonyImsOverlay",
        ],
    }) + select(soong_config_variable("qssi", "supports_5g"), {
        false: [],
        default: ["QssiFrameworksTelephony5gOverlay"],
    }),
}
